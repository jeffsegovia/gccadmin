# Postgres: the same database v2 (Prisma) used. A plain postgres:// URL
# (not a Prisma Accelerate one); on Vercel use the pooled connection string.
DATABASE_URL=postgresql://postgres:admin@localhost:5432/gccdb

# Clerk (same instance as v2, so accounts and roles carry over).
# Leave both empty in local dev for the preview mode (a stand-in admin).
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local preview only: whose network you see (a Disciple id), and
# DEV_ROLE=leader to see the app as a leader instead of an admin.
DEV_DISCIPLE_ID=
DEV_ROLE=

# Who "Request access" emails, and the senior pastor's name (promoting a
# primary leader puts them in this network, as in v2).
ADMIN_EMAIL=
SENIOR_PASTOR_NAME=John De Guzman

# Email (Resend). Sent only on an action (a report from a disciple's
# page, a linked leader account) or a button (reminders, the weekly
# summary); nothing is scheduled. Without a key, `pnpm dev` prints emails
# to the terminal. Staging: EMAIL_REDIRECT_TO sends every email to one inbox.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_REDIRECT_TO=
# The public address: links in emails and the share image.
SITE_URL=https://your-domain.example

# GCC Resources (Google Drive service account, as in v2).
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_CLIENT_ID=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
